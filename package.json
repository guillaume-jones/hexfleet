{
  "name": "hexfleet",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint --fix --ext .js,.jsx,.ts,.tsx ./src --max-warnings 0 && prettier --loglevel silent --write ./src && npx tsc --noEmit",
    "lint:ci": "eslint --ext .js,.jsx,.ts,.tsx ./src --max-warnings 0 && npx tsc --noEmit",
    "test": "jest",
    "deploy-firebase": "firebase login --reauth --interactive && firebase deploy --only functions",
    "types": "npx tsc --noEmit",
    "find-deadcode": "ts-prune"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.8",
    "@heroicons/react": "^2.0.14",
    "firebase": "^10.8.0",
    "lodash": "^4.17.21",
    "nanoid": "^5.0",
    "next": "^13.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-feather": "^2.0.10",
    "react-firebase-hooks": "^5.1.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^13.5",
    "@trivago/prettier-plugin-sort-imports": "^4.0.0",
    "@types/lodash": "^4.14.191",
    "@types/node": "18.11.18",
    "@types/react": "18.0.27",
    "@types/react-dom": "18.0.10",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "autoprefixer": "^10.4.13",
    "eslint": "^8.33.0",
    "eslint-config-next": "^13.5",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-no-relative-import-paths": "^1.5.2",
    "postcss": "^8.4.21",
    "prettier": "^2.8.3",
    "prettier-plugin-tailwindcss": "^0.2.2",
    "tailwindcss": "^3.4.1",
    "ts-prune": "^0.10.3",
    "typescript": "4.9.4"
  },
  "compilerOptions": {
    "esModuleInterop": true
  }
}
